# Copy to .env and fill in. Never commit real secrets (.env is gitignored).

# API
PORT=3001
# "dev" accepts an X-Dev-User header for local testing; use "entra" in production.
VRC_AUTH_MODE=dev

# Microsoft Entra ID (OIDC) — required when VRC_AUTH_MODE=entra
VRC_ENTRA_TENANT_ID=
VRC_ENTRA_AUDIENCE=

# Database (PostgreSQL) — used by the Prisma layer that replaces the in-memory store
DATABASE_URL=postgresql://user:pass@localhost:5432/vrc

# AI model access for the agentic workflow (used by the agent host, not the MCP server)
ANTHROPIC_API_KEY=
